  <build>
    <finalName>modloader-agent</finalName>
    <plugins>
      <!-- Shade: bundle ASM/Gson/Mixin INTO the agent jar so it has zero external classpath deps -->
	<plugin>
		<groupId>org.apache.maven.plugins</groupId>
		<artifactId>maven-shade-plugin</artifactId>
		<version>3.6.1</version>
		<executions>
			<execution>
				<phase>package</phase>
				<goals><goal>shade</goal></goals>
				<configuration>
					<relocations>
						<!--
						  KHÔNG relocate org.objectweb.asm nữa.

						  Lý do: MixinExtras (và có thể các thư viện Fabric khác) dùng
						  reflection để tìm method nội bộ của chính Mixin bằng tên ASM GỐC,
						  ví dụ ClassInfo.fromClassNode(org.objectweb.asm.tree.ClassNode).
						  Relocate org.objectweb.asm sẽ viết lại luôn bytecode NỘI BỘ của
						  sponge-mixin (không chỉ code của chúng ta), đổi chữ ký method đó
						  thành ...libs.asm.tree.ClassNode -> reflection lookup của
						  MixinExtras luôn throw NoSuchMethodException (đã xác nhận qua log).

						  Không cần relocate để né conflict version nữa vì:
						  1) Paper (server) và project này đều dùng đúng ASM 9.9.1 — không có
						     version nào khác để đụng độ.
						  2) Ngay cả nếu khác version, ASM/Mixin của agent chạy trên
						     mixinHost classloader tách biệt hoàn toàn khỏi bukkitLoader của
						     Paper (xem MixinAwareClassLoader) — 2 bản class không bao giờ
						     cần ép kiểu qua lại nên không xung đột.

						  Filter "LOẠI BỎ ASM CŨ CỦA MIXIN" bên dưới vẫn giữ nguyên — vẫn cần
						  để đảm bảo org/objectweb/asm/** trong jar cuối cùng chỉ đến từ 1
						  nguồn duy nhất (org.ow2.asm:asm:9.9.1 của chính chúng ta), không bị
						  đè bởi bản ASM mà sponge-mixin tự bundle kèm.
						-->
						<relocation>
							<pattern>com.google.gson</pattern>
							<shadedPattern>ankhangbo.modloader.libs.gson</shadedPattern>
						</relocation>
					</relocations>

					<transformers>
						<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
							<manifestEntries>
								<Premain-Class>ankhangbo.fabricloader.FabricLoaderAgent</Premain-Class>
								<Agent-Class>ankhangbo.fabricloader.FabricLoaderAgent</Agent-Class>
								<Main-Class>ankhangbo.fabricloader.FabricLoaderAgent</Main-Class>
								<Can-Retransform-Classes>true</Can-Retransform-Classes>
								<Can-Redefine-Classes>true</Can-Redefine-Classes>
								<Implementation-Title>ASM</Implementation-Title>
								<Implementation-Version>9.10.1</Implementation-Version>
								<Bundle-Name>org.objectweb.asm</Bundle-Name>
								<Bundle-Version>9.10.1</Bundle-Version>
							</manifestEntries>
						</transformer>
						<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
					</transformers>
					
					<filters>
						<filter>
							<artifact>net.fabricmc:sponge-mixin</artifact>
							<excludes>
								<exclude>org/objectweb/asm/**</exclude>
							</excludes>
						</filter>
						
						<!-- Filter chung -->
						<filter>
							<artifact>*:*</artifact>
							<excludes>
								<exclude>module-info.class</exclude>
								<exclude>META-INF/*.SF</exclude>
								<exclude>META-INF/*.DSA</exclude>
								<exclude>META-INF/*.RSA</exclude>
							</excludes>
						</filter>
					</filters>
				</configuration>
			</execution>
		</executions>
	</plugin>

      <!-- Manifest: Premain-Class + Agent-Class + retransform flags -->
		<plugin>
